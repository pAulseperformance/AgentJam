{
  // Agent-First Web DAW Jam Room, Unified Worker Pattern
  // Frontend assets + DO served from the same origin (no CORS friction)
  "name": "agent-jam",
  "compatibility_date": "2025-03-15",
  "workers_dev": true,
  // A PREVIEW URL per uploaded version, so a change is exercised on Cloudflare's edge (real AI,
  // real routes) before it takes the live traffic. Set by `wrangler versions upload`.
  "preview_urls": true,
  "main": "src/server/index.ts",

  // Unified Worker: assets fallthrough for SPA routing.
  //
  // The build nests its output under ./dist/jam because the app lives at a PATH now, and the asset
  // layer finds a request by its path. `not_found_handling: "none"` is deliberate: with the SPA
  // fallback on, the asset layer answers every navigation BEFORE this Worker runs and serves the
  // assets-directory ROOT shell, which is the wrong door's bundle. The binding is what lets the
  // Worker serve the mount's own shell for a client route.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // THE PAGE IS COMPOSED, SO THE WORKER SEES IT FIRST. `/jam/` is a real file in `dist/jam/` (Vite's
    // index.html), so the asset layer answered it before this Worker ran and the estate's shell around
    // that bundle was never drawn (measured 2026-10-30: 2,033 B, no fleet sheet, no bar, while a client
    // route like /jam/room/abc got the 3,195 B shell). These two patterns are the pages only; the bundle
    // under /jam/assets/ keeps its direct path.
    "run_worker_first": ["/jam", "/jam/"],
    "not_found_handling": "none"
  },

  // Workers AI binding, free for Llama models
  "ai": {
    "binding": "AI"
  },

  // Durable Objects binding
  "durable_objects": {
    "bindings": [
      {
        "name": "JAM_ROOM",
        "class_name": "JamRoom"
      }
    ]
  },

  // SQLite-backed DO storage (default for new DOs)
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["JamRoom"]
    }
  ],

  // THE PAGE DOOR IS THE MOUNT (zpe.vc/jam). The custom domain keeps answering the room API, but its
  // PAGE requests are answered upstream with a 302 to /services, measured 2026-10-30: a HEAD reaches
  // this Worker and gets a 301, a GET never arrives. See docs/FINDINGS.md. One deployment, and the
  // mount takes TWO route patterns because a trailing * is a string wildcard that would also capture
  // /jam-other; a path pattern needs `zone_name` (a custom_domain does not).
  "routes": [
    { "pattern": "jam.zpe.vc", "custom_domain": true },
    { "pattern": "zpe.vc/jam", "zone_name": "zpe.vc" },
    { "pattern": "zpe.vc/jam/*", "zone_name": "zpe.vc" }
  ],
  "vars": {
    // WHERE THE APP IS MOUNTED, and the host that owns the mount. The room socket and the API answer
    // on both names; page requests only on the mount. The workers.dev address is left alone (it is
    // neither).
    "PATH_PREFIX": "/jam",
    "MOUNT_ORIGIN": "https://zpe.vc",
    "CANONICAL_HOST": "jam.zpe.vc",

    // THE SIGNED-IN DECISION LAYER. Jev (TypeSafe System One) never renders text: it answers typed
    // questions about what to play, and the model below renders them. The endpoint and slug are
    // public facts (the router prefixes the slug: `jev-latest` is the direct-call name); the key is a
    // secret (`wrangler secret put JEV_API_KEY`), never a var. Unset key = every room is public.
    "JEV_ENDPOINT": "https://openrouter.ai/api/alpha/decisions",
    "JEV_MODEL": "typesafe/jev-1.13"
  }
}
